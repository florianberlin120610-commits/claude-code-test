generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Channel {
  id             String   @id @default("default")
  name           String   @default("")
  niche          String   @default("")
  platform       String   @default("tiktok")
  targetAudience String   @default("")
  style          String   @default("")
  goal           String   @default("")
  updatedAt      DateTime @updatedAt
}

model Post {
  id              String   @id @default(cuid())
  title           String
  platform        String
  publishedAt     DateTime
  weekday         Int
  durationSeconds Int
  hookType        String
  hookText        String
  topicCategory   String
  hasCta          Boolean  @default(false)
  isSeries        Boolean  @default(false)
  seriesName      String?
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  linkClicks      Int?
  purchases       Int?
  hookScore       Float    @default(0)
  engagementRate  Float    @default(0)
  status          String   @default("published")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
